# Telegram API credentials: https://my.telegram.org/apps
API_ID=123456
API_HASH=replace_with_your_api_hash
# Bot token from @BotFather
BOT_TOKEN=123456789:replace_with_your_bot_token
# Numeric Telegram IDs allowed to use this private bot (comma separated)
ALLOWED_USER_IDS=123456789
# Minimum spacing between API calls. Telegram may still impose FloodWait.
CHECK_DELAY=2.0
# Public-page mode spacing between HTTP requests, in seconds (minimum 1)
WEB_CHECK_DELAY=1.0
# Optional default for people without a saved preference: botonly or account.
# Omit to use account when a session file exists, otherwise botonly.
# DEFAULT_MODE=botonly
# Optional absolute persistent directory; default is ./data beside bot.py
# DATA_DIR=/absolute/path/to/data

